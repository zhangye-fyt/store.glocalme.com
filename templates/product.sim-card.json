            "text_underline_width": 100,
            "text_underline_height": 2,
            "text_underline_gradient_background": "",
            "direction_x": "ltr",
            "direction_y": "ttb",
            "position_x": 20,
            "position_y": 46.8
          }
        },
        "text_J5c3cj": {
          "type": "text",
          "settings": {
            "text": "<p>You can recharge your SIM card through this link:https://www.glocalme.com/product/glocalme-sim-card-recharge. Please leave your ICCID NO. in the order notes on the checkout page, our team member will recharge the SIM card for you.</p>",
