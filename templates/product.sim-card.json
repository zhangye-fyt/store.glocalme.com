    "image_text_separation_04": {
      "type": "image-text-separation",
      "blocks": {
        "image_Cz2E1F": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/SIM_04.jpg",
            "image_link": ""
          }
        },
        "text_Jx2C3F": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Q&A</strong></p>",
            "text_color": "#3a3a3c",
            "text_gradient_background": "linear-gradient(119deg, rgba(56, 221, 92, 1) 20%, rgba(3, 58, 160, 1) 60%)",
            "text_font_size": 86,
            "text_font_weight": 600,
            "text_line_height": 1.2,
            "text_align": "center",
            "enable_text_underline": false,
            "text_underline_width": 100,
            "text_underline_height": 2,
            "text_underline_gradient_background": "",
            "direction_x": "rtl",
            "direction_y": "ttb",
            "position_x": 5,
            "position_y": 8
          }
        },
        "text_Y2c5cX": {
          "type": "text",
          "settings": {
            "text": "<p>What's the difference of your CloudSIM data plan and SIM Card plan?</p>",
            "text_color": "#ffffff",
            "text_gradient_background": "",
            "text_font_size": 36,
            "text_font_weight": 400,
            "text_line_height": 1.2,
            "text_align": "left",
            "max_text_container_max_width": 52,
            "enable_text_underline": false,
            "text_underline_width": 100,
            "text_underline_height": 2,
            "text_underline_gradient_background": "",
            "direction_x": "ltr",
            "direction_y": "ttb",
            "position_x": 18,
            "position_y": 20
          }
        },
        "text_Y5c5cj": {
          "type": "text",
          "settings": {
            "text": "<p>Our CloudSIM data plan is associated with GlocalMe Hotspot device, but SIM Card plan corresponds to SIM card, which can not be inserted into our GlocalMe Hotspot device.</p>",
            "text_color": "#4b4b4b",
            "text_gradient_background": "",
            "text_font_size": 36,
            "text_font_weight": 400,
            "text_line_height": 1.2,
            "text_align": "left",
            "max_text_container_max_width": 52,
            "enable_text_underline": false,
            "text_underline_width": 100,
            "text_underline_height": 2,
            "text_underline_gradient_background": "",
            "direction_x": "ltr",
            "direction_y": "ttb",
            "position_x": 26,
            "position_y": 32
          }
        },
        "text_J2c5cu": {
          "type": "text",
          "settings": {
            "text": "<p>Is there a link to recharge the SIM card?</p>",
            "text_color": "#ffffff",
            "text_gradient_background": "",
            "text_font_size": 36,
            "text_font_weight": 400,
            "text_line_height": 1.2,
            "text_align": "left",
            "max_text_container_max_width": 52,
            "enable_text_underline": false,
            "text_underline_width": 100,
            "text_underline_height": 2,
            "text_underline_gradient_background": "",
            "direction_x": "ltr",
            "direction_y": "ttb",
            "position_x": 18,
            "position_y": 48.4
          }
        },
        "text_J5c3cj": {
          "type": "text",
          "settings": {
            "text": "<p>You can recharge your SIM card through <a href=\"/products/glocalme-sim-card-recharge\" title=\"GlocalMe SIM Card Recharge\">GlocalMe SIM Card Recharge</a>. Please leave your ICCID NO. in the order notes on the checkout page, our team member will recharge the SIM card for you.</p>",
            "text_color": "#4b4b4b",
            "text_gradient_background": "",
            "text_font_size": 36,
            "text_font_weight": 400,
            "text_line_height": 1.2,
            "text_align": "left",
            "max_text_container_max_width": 52,
            "enable_text_underline": false,
            "text_underline_width": 100,
            "text_underline_height": 2,
            "text_underline_gradient_background": "",
            "direction_x": "ltr",
            "direction_y": "ttb",
            "position_x": 26,
            "position_y": 57.4
          }
        },
        "text_H2c5c7": {
          "type": "text",
          "settings": {
            "text": "<p>How long is the validity period of a SIM card?</p>",
            "text_color": "#ffffff",
            "text_gradient_background": "",
            "text_font_size": 36,
            "text_font_weight": 400,
            "text_line_height": 1.2,
            "text_align": "left",
            "max_text_container_max_width": 52,
            "enable_text_underline": false,
            "text_underline_width": 100,
            "text_underline_height": 2,
            "text_underline_gradient_background": "",
            "direction_x": "ltr",
            "direction_y": "ttb",
            "position_x": 18,
            "position_y": 77
          }
        },
        "text_F5c3c5": {
          "type": "text",
          "settings": {
            "text": "<p>You need to activate it within 3 months after purchase. It may become invalid after the expiration date.</p>",
            "text_color": "#4b4b4b",
            "text_gradient_background": "",
            "text_font_size": 36,
            "text_font_weight": 400,
            "text_line_height": 1.2,
            "text_align": "left",
            "max_text_container_max_width": 52,
            "enable_text_underline": false,
            "text_underline_width": 100,
            "text_underline_height": 2,
            "text_underline_gradient_background": "",
            "direction_x": "ltr",
            "direction_y": "ttb",
            "position_x": 26,
            "position_y": 85
          }
        }
      },
