        "text_Y2c5cX": {
          "type": "text",
          "settings": {
            "text": "<p>What's the difference of your CloudSIM data planand SIM Card plan?</p>",
            "text_color": "#ffffff",
            "text_gradient_background": "",
            "text_font_size": 18,
            "text_font_weight": 400,
            "text_line_height": 1.2,
            "text_align": "left",
            "max_text_container_max_width": 60,
            "enable_text_underline": false,
            "text_underline_width": 100,
            "text_underline_height": 2,
            "text_underline_gradient_background": "",
            "direction_x": "ltr",
            "direction_y": "ttb",
            "position_x": 20,
            "position_y": 16
          }
        },
        "text_Y5c5cj": {
          "type": "text",
          "settings": {
            "text": "<p>Our CloudSIM data plan is associated with GlocalMe Hotspot device, but SIM Card plan corresponds to SIM card, which can not be inserted into our GlocalMe Hotspot device.</p>",
            "text_color": "#4b4b4b",
            "text_gradient_background": "",
            "text_font_size": 18,
            "text_font_weight": 400,
            "text_line_height": 1.2,
