    "collapsible_content_cHgJWm": {
      "type": "collapsible-content",
      "blocks": {
        "accordion_Nytq9n": {
          "type": "accordion",
          "settings": {
            "question": "In what situation the signal will change to GPS or LBS?",
            "answer": "<p>PetPhone uses 6-positioning technology to locate and intelligently select positioning technology for positioning. Generally speaking, GPS positioning is used outdoors, and base station/WiFi positioning is used indoors.</p>",
            "opened": false
          }
        },
        "accordion_zXCPqP": {
          "type": "accordion",
          "settings": {
            "question": "How does the activity level measure? How do you calculate the cal for daily consumption?",
            "answer": "<p>By capturing pet movement and activity data through devices, we are constantly improving the algorithm and adjusting it based on the consumption of more types of pets.</p>",
            "opened": false
          }
        },
        "accordion_AYFPAM": {
          "type": "accordion",
          "settings": {
            "question": "It is not very convenient if we cannot use the Live mode to record the walk pathway/route if we leave the app screen.",
            "answer": "<p>You can view your walking route through the history track function.</p>",
            "opened": false
          }
        },
        "accordion_Uq3CaB": {
          "type": "accordion",
          "settings": {
            "question": "There is level of Rest / Sleep / heartrate etc in other tracker, can it be also calculate in PetPhone?",
            "answer": "<p>After internal evaluation and confirmation, it will be included in the subsequent functional planning.</p>",
            "opened": false
          }
        },
        "accordion_qPmY8H": {
          "type": "accordion",
          "settings": {
            "question": "Is there a limit on the number of two-way calls? How does my pet call me?",
            "answer": "<p>There is no limit on the number of calls. Calls are enabled through Cloud SIM technology. Simply purchase the service plan to enjoy unlimited network calls! Your pet can trigger the dialing function by jumping three times within six seconds. (This feature can be disabled within the app.)</p>",
            "opened": false
          }
        },
        "accordion_6AQRkN": {
          "type": "accordion",
          "settings": {
            "question": "Is the two-way calling feature limited by distance?",
            "answer": "<p>PetPhone is a SIM-free device utilising cloud card technology. It supports over 390 global operators across more than 200 countries and regions, functioning wherever network coverage is available without distance limitations.</p>",
            "opened": false
          }
        },
        "accordion_LBVgWq": {
          "type": "accordion",
          "settings": {
            "question": "Can AI Health data be shared directly to the Pet Community within the app?",
            "answer": "<p>This feature is not currently supported. However, AI Health data can be saved as images to your system gallery. You can manually select these images within the community to post and share your pet's activity data!</p>",
            "opened": false
          }
        }
      },
