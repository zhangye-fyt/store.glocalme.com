            "position_x": 17,
            "position_y": 41.6
          }
        },
        "text_Ix4XH1": {
          "type": "text",
          "settings": {
            "text": "<p>Once you make the payment, we will send your GlocalMe eSIM to the email you entered during the purchase process. Say goodbye to the days of waiting for a physical SIM card in the mail.</p>",
