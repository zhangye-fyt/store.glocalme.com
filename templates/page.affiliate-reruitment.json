      "type": "collapsible-content",
      "blocks": {
        "accordion_7rcJih": {
          "type": "accordion",
          "settings": {
            "question": "1. What is the GlocalMe Affiliate Program?",
            "answer": "<p><br/>The GlocalMe Affiliate Program invites review sites, online communities, bloggers, and other content creators to promote products and services on their sites and earn commissions on the sales they refer to <a href=\"https://store.glocalme.com/\" title=\"https://store.glocalme.com/\"><strong>store.glocalme.com</strong></a>.<br/><br/></p>",
            "opened": true
          }
        },
        "accordion_Gmrq4m": {
          "type": "accordion",
          "settings": {
            "question": "2. How much commission will l earn?",
            "answer": "<p>Earn a minimum of 10% commission on qualifying purchases made through your affiliate links. Your exact earnings will be shown in your reports on affiliate networks</p>",
            "opened": false
          }
        },
        "accordion_z6t68z": {
          "type": "accordion",
          "settings": {
            "question": "3. How can l start earning commission?",
            "answer": "<p>Step 1: Apply for the affiliate program and sign up as an affiliate or a publisher. </p><p>Step 2: Receive our links, promote them, and watch your commissions roll in.</p>",
            "opened": false
          }
        },
        "accordion_cALjbN": {
          "type": "accordion",
          "settings": {
            "question": "4. What types of promotions are not permitted?",
            "answer": "<p>To keep the affiliate program fair, a number of promotion types are not permitted, including but not limited to the following: </p><ul><li>False links: The use of illegal means to tamper with the target user link.</li><li>Creation of pop-ups or scripts to simulate genuine purchase patterns.</li><li> Persistent pop-ups and full-screen pop-ups.</li><li>Hiding links under other content.</li><li>Putting links directly into search engines, including but not limited to Google, Yahoo, and Bing.</li><li>Tricking people into clicking links.</li><li> Creating seemingly official GlocalMe websites to mislead people into purchasing.</li><li>Any actions in violation of GlocalMe Affiliate Program terms.</li><li>GlocalMe has the right to penalize those who violate the GlocalMe Affiliate Program agreement.</li></ul>",
            "opened": false
          }
        },
        "accordion_nhqKb4": {
          "type": "accordion",
          "settings": {
            "question": "5. Why was my commission withdrawn after the order was completed?",
            "answer": "<ul><li>Commissions may be reversed in the following cases:</li><li>‒ The order is refunded or canceled.</li><li>‒ Fraudulent orders.</li><li>‒ The same order is attributed to multiple affiliate platforms (based on UTM parameters).</li><li>If you have any questions, please don't hesitate to contact affiliate@glocalme.com.</li></ul>",
            "opened": false
          }
        }
