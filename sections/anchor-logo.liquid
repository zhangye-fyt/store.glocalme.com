{{ 'component-anchor-logo.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}

  #AnchorLogo-{{ section.id }} .anchor-logo__content {
    text-align: {{ section.settings.content_alignment }};
  }

  @media (max-width: 749px) {
    #AnchorLogo-{{ section.id }} .anchor-logo__logo {
      grid-template-columns: repeat({{ section.settings.number_mobile }}, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

<div id="AnchorLogo-{{ section.id }}" class="anchor-logo section-{{ section.id }}-padding">
  <div class="container">
    <anchor-target-text>
      <div class="anchor-logo__title titles titles--{{ section.settings.title_alignment }}">
        <h2>{{- section.settings.title -}}</h2>
      </div>
      <div class="anchor-logo__description description description--{{ section.settings.title_alignment }} body-large">
        {{- section.settings.description -}}
      </div>
      <div
        class="anchor-logo__logo"
        style="--logo-gap: {{ section.settings.logo_gap }};--logo-gap-mobile: {{ section.settings.logo_gap_mobile }};"
        data-anchors
      >
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'logo' -%}
              <div
                class="anchor-logo__logo-item cursor-pointer"
                style="--logo-width: {{ block.settings.image_width }}px"
                {% if block.settings.target_text != blank %}
                  data-anchor
                  data-anchor-target-text="{{ block.settings.target_text }}"
                {% endif %}
              >
                {%- if block.settings.image -%}
                  <div
                    class="ratio"
                    style="--ratio-percent: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | round: 2 }}%"
                  >
                    {%- assign height = block.settings.image_width | divided_by: block.settings.image.aspect_ratio -%}
                    {{
                      block.settings.image
                      | image_url: width: block.settings.image_width
                      | image_tag:
                        loading: 'lazy',
                        sizes: '(min-width: 1100px) 750, (min-width: 750px) 550, 275',
                        widths: '275, 550, 750',
                        width: block.settings.image_width,
                        height: height
                    }}
                  </div>
                {%- else -%}
                  {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <div class="anchor-logo__content">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'text' -%}
                <div class="anchor-logo__content-text">
                  {{ block.settings.text }}
                </div>
              {%- when 'image' -%}
                {%- assign ratio = block.settings.image.aspect_ratio -%}
                <div
                  class="anchor-logo__content-image ratio"
                  style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
                >
                  {%- if block.settings.image -%}
                    {{
                      block.settings.image
                      | image_url: width: block.settings.image.width
                      | image_tag:
                        class: 'w-full h-auto',
                        width: section.settings.image.width,
                        height: section.settings.image.height,
                        loading: 'lazy',
                        widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3264, 3400, 3584, 3800, 4000, 4200, 4400, 4600, 4800, 5000, 5200, 5400, 5600',
                        sizes: 'calc(100vw - 40px)'
                    }}
                  {%- else -%}
                    {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </anchor-target-text>
  </div>
</div>

