{{ 'component-image-text-accordion.css' | asset_url | stylesheet_tag }}
<script defer src="{{ 'image-text-accordion.js' | asset_url }}"></script>

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<div id="ImageTextAccordion-{{ section.id }}" class="image-text-accordion section-{{ section.id }}-padding">
  <div class="container">
    <div class="image-text-accordion__container">
      <image-text-accordion>
        <div class="image-text-accordion__wrapper">
          {%- capture sizes -%}calc(100vw / {{ section.blocks.size }}){%- endcapture -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign cover_ratio = section.settings.cover_ratio
              if cover_ratio == 'adapt' and block.settings.image != blank
                assign ratio_percent = 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | round: 2
              elsif cover_ratio == 'adapt' and block.settings.image == blank
                assign ratio_percent = 100
              else
                assign cover_ratio = section.settings.cover_ratio
                assign aspect_ratio = cover_ratio | split: '/'
                assign temp = aspect_ratio[0] | append: '.0'
                assign ratio_percent = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
              endif
            -%}
            <div
              class="image-text-accordion__image ratio{% if forloop.first %} active{% endif %}"
              style="--ratio-percent: {{ ratio_percent }}%"
            >
              {%- if block.settings.image -%}
                {{
                  block.settings.image
                  | image_url: width: 750
                  | image_tag:
                    widths: '360, 535, 720, 940, 1070, 1200, 1400, 1600, 1800, 2000, 2200',
                    sizes: sizes,
                    class: 'object-cover'
                }}
              {%- else -%}
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="image-text-accordion__text color-{{ section.settings.color_scheme }}">
              <div class="image-text-accordion__text-inner">
                {%- if block.settings.title -%}
                  <h3 class="body-large">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.description -%}
                  <p>{{ block.settings.description }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </image-text-accordion>
      <swiper-component
        class="image-text-accordion__swiper relative"
        data-options='{"loop":{{ section.settings.enable_loop }},"spaceBetween":10}'
        data-pagination="true"
      >
        <div class="swiper">
          <div class="swiper-wrapper">
            {%- capture sizes -%}calc(100vw / {{ section.blocks.size }}){%- endcapture -%}
            {%- for block in section.blocks -%}
              <div class="swiper-slide">
                <image-text-accordion class="image-text-accordion__grid h-full">
                  {%- liquid
                    assign cover_ratio = section.settings.cover_ratio
                    if cover_ratio == 'adapt' and block.settings.image != blank
                      assign ratio_percent = 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | round: 2
                    elsif cover_ratio == 'adapt' and block.settings.image == blank
                      assign ratio_percent = 100
                    else
                      assign cover_ratio = section.settings.cover_ratio
                      assign aspect_ratio = cover_ratio | split: '/'
                      assign temp = aspect_ratio[0] | append: '.0'
                      assign ratio_percent = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
                    endif
                  -%}
                  <div
                    class="image-text-accordion__image ratio"
                    style="--ratio-percent: {{ ratio_percent }}%"
                  >
                    {%- if block.settings.image -%}
                      {{
                        block.settings.image
                        | image_url: width: 750
                        | image_tag:
                          widths: '360, 535, 720, 940, 1070, 1200, 1400, 1600, 1800, 2000, 2200',
                          sizes: sizes,
                          class: 'object-cover'
                      }}
                    {%- else -%}
                      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  <div class="image-text-accordion__text color-{{ section.settings.color_scheme }}">
                    <div class="relative h-full">
                      <div class="image-text-accordion__text-inner absolute top-0 left-0 w-full h-full">
                        {%- if block.settings.title -%}
                          <h3 class="body-large">{{ block.settings.title }}</h3>
                        {%- endif -%}
                        {%- if block.settings.description -%}
                          <p>{{ block.settings.description }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                </image-text-accordion>
              </div>
            {%- endfor -%}
          </div>
        </div>
        {%- if section.settings.enable_pagination -%}
          <div class="swiper-pagination"></div>
        {%- endif -%}
      </swiper-component>
    </div>
  </div>
</div>

