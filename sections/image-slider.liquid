{{ 'component-image-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}

  {%- if section.settings.display_devices == 'desktop' -%}
    #ImageSlider-{{ section.id }} {
      display: none;
    }
    @media screen and (min-width: 750px) {
      #ImageSlider-{{ section.id }} {
        display: block;
      }
    }
  {%- elsif section.settings.display_devices == 'mobile' -%}
    @media screen and (min-width: 750px) {
      #ImageSlider-{{ section.id }} {
        display: none;
      }
    }
  {%- endif -%}
{%- endstyle -%}

<div id="ImageSlider-{{ section.id }}" class="image-slider section-{{ section.id }}-padding">
  <div class="container">
    {%- capture autoplay -%}
      {%- if section.settings.enable_autoplay -%}
        {"delay":{{ section.settings.slide_duration | times: 1000 }}}
      {%- else -%}
        false
      {%- endif -%}
    {%- endcapture -%}
    <swiper-component
      class="relative"
      data-options='{"autoplay":{{ autoplay }},"slidesPerView":1,"spaceBetween":10,"breakpoints":{"750":{"slidesPerView":3,"spaceBetween":20}}}'
      data-arrow="true"
      data-pagination="true"
    >
      <div class="swiper">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            <div class="swiper-slide">
              {%- liquid
                assign cover_ratio = section.settings.cover_ratio
                if cover_ratio == 'adapt' and block.settings.image != blank
                  assign ratio_percent = 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | round: 2
                elsif cover_ratio == 'adapt' and block.settings.image == blank
                  assign ratio_percent = 100
                else
                  assign aspect_ratio = cover_ratio | split: '/'
                  assign temp = aspect_ratio[0] | append: '.0'
                  assign ratio_percent = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
                endif
              -%}
              <div
                class="ratio"
                style="--ratio-percent: {{ ratio_percent }}%"
              >
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 750
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) calc((100vw - 40px) / 3), calc(100vw - 40px)',
                      widths: '360, 535, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600',
                      width: block.settings.image.width,
                      height: block.settings.image.height,
                      class: 'object-cover'
                  }}
                {%- else -%}
                  {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
      {%- if section.settings.enable_navigation -%}
        <div class="swiper-navigation">
          <div class="swiper-button-prev">
            {% render 'icon-caret-left' %}
          </div>
          <div class="swiper-button-next">
            {% render 'icon-caret-right' %}
          </div>
        </div>
      {%- endif -%}
      {%- if section.settings.enable_pagination -%}
        <div class="swiper-pagination"></div>
      {%- endif -%}
    </swiper-component>
  </div>
</div>

