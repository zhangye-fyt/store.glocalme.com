{{ 'component-banner-column.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}

  #BannerColumn-{{ section.id }} .banner-column__wrapper {
    grid-template-columns: repeat({{ section.blocks.size }}, minmax(0, 1fr));
  }
  #BannerColumn-{{ section.id }} .banner-column__wrapper .banner-column__image::after {
    opacity: {{ section.settings.opacity_overlay  }};
  }
{%- endstyle -%}

<div id="BannerColumn-{{ section.id }}" class="banner-column section-{{ section.id }}-padding">
  <div class="banner-column__container">
    <div class="banner-column__wrapper{% if section.settings.full_width != true %} container{% endif %}">
      {%- capture sizes -%}calc(100vw / {{ section.blocks.size }}){%- endcapture -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a
            class="banner-column__item relative"
            href="{{ block.settings.link }}"
            aria-label="{{ block.settings.link.title | escape }}"
          >
        {%- else -%}
          <div class="banner-column__item relative">
        {%- endif -%}
        {%- liquid
          assign image_ratio = section.settings.image_ratio
          if image_ratio == 'adapt' and block.settings.image != blank
            assign ratio_percent = 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | round: 2
          elsif image_ratio == 'adapt' and block.settings.image == blank
            assign ratio_percent = 100
          else
            assign image_ratio = section.settings.image_ratio
            assign aspect_ratio = image_ratio | split: '/'
            assign temp = aspect_ratio[0] | append: '.0'
            assign ratio_percent = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
          endif
        -%}
        <div
          class="banner-column__image ratio{% if forloop.first %} active{% endif %}"
          style="--ratio-percent: {{ ratio_percent }}%"
        >
          {%- if block.settings.image -%}
            {%- capture style -%}object-fit: {{ section.settings.image_fit }};{%- endcapture -%}
            {{
              block.settings.image
              | image_url: width: 750
              | image_tag:
                widths: '360, 535, 720, 940, 1070, 1200, 1400, 1600, 1800, 2000, 2200',
                sizes: sizes,
                class: 'object-cover',
                style: style
            }}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="banner-column__text color-{{ section.settings.color_scheme }}">
          <div class="banner-column__text-inner">
            {%- if block.settings.title -%}
              <h3 class="h4">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description -%}
              <p class="body-xs">{{ block.settings.description }}</p>
            {%- endif -%}
            {%- if section.settings.show_button -%}
              <button class="button button--primary flex-1">
                {{ section.settings.button_text }}
              </button>
            {%- endif -%}
          </div>
        </div>
        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="container">
      {%- capture autoplay -%}
        {%- if section.settings.enable_autoplay -%}
          {"delay":{{ section.settings.slide_duration | times: 1000 }}}
        {%- else -%}
          false
        {%- endif -%}
      {%- endcapture -%}
      <swiper-component
        class="banner-column__swiper relative"
        data-options='{"autoplay":{{ autoplay }},"slidesPerView":1,"loop":{{ section.settings.enable_loop }},"spaceBetween":10}'
        data-pagination="true"
      >
        <div class="swiper">
          <div class="swiper-wrapper">
            {%- capture sizes -%}calc(100vw / {{ section.blocks.size }}){%- endcapture -%}
            {%- for block in section.blocks -%}
              <div class="swiper-slide">
                {%- if block.settings.link != blank -%}
                  <a
                    class="banner-column__item h-full"
                    href="{{ block.settings.link }}"
                    aria-label="{{ block.settings.link.title | escape }}"
                  >
                {%- else -%}
                  <div class="banner-column__item h-full">
                {%- endif -%}
                {%- liquid
                  assign image_ratio_mobile = section.settings.image_ratio_mobile
                  if image_ratio_mobile == 'adapt' and block.settings.image != blank
                    assign ratio_percent = 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | round: 2
                  elsif image_ratio_mobile == 'adapt' and block.settings.image == blank
                    assign ratio_percent = 100
                  else
                    assign image_ratio_mobile = section.settings.image_ratio_mobile
                    assign aspect_ratio = image_ratio_mobile | split: '/'
                    assign temp = aspect_ratio[0] | append: '.0'
                    assign ratio_percent = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
                  endif
                -%}
                <div
                  class="banner-column__image ratio"
                  style="--ratio-percent: {{ ratio_percent }}%"
                >
                  {%- if block.settings.image -%}
                    {%- capture style -%}object-fit: {{ section.settings.image_fit }};{%- endcapture -%}
                    {{
                      block.settings.image
                      | image_url: width: 750
                      | image_tag:
                        widths: '360, 535, 720, 940, 1070, 1200, 1400, 1600, 1800, 2000, 2200',
                        sizes: sizes,
                        style: style
                    }}
                  {%- else -%}
                    {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="banner-column__text color-{{ section.settings.color_scheme_mobile }}">
                  <div class="relative h-full">
                    <div
                      class="banner-column__text-inner"
                      style="text-align: {{ section.settings.title_alignment_mobile }};"
                    >
                      {%- if block.settings.title -%}
                        <h3 class="h4">{{ block.settings.title }}</h3>
                      {%- endif -%}
                      {%- if block.settings.description -%}
                        <p class="body-xs">{{ block.settings.description }}</p>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
                {%- if block.settings.link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
        {%- if section.settings.enable_pagination -%}
          <div class="swiper-pagination"></div>
        {%- endif -%}
      </swiper-component>
    </div>
  </div>
</div>

