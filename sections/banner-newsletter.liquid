{{ 'section-banner-newsletter.css' | asset_url | stylesheet_tag }}

<script src="{{ 'banner-newsletter.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign image_ratio = section.settings.image_ratio
-%}

{%- if image_ratio == 'adapt' and section.settings.image != blank -%}
  {% assign ratio_percent = 1 | divided_by: section.settings.image.aspect_ratio | times: 100 | round: 2 %}
  {% assign ratio_percent_mobile = 1 | divided_by: section.settings.image_mobile.aspect_ratio | times: 100 | round: 2 %}
  {% style %}
    @media screen and (max-width: 989px) {
      #BannerWithNewsletter-{{ section.id }} .banner__media.ratio {
        --ratio-percent: {{ ratio_percent_mobile }}%;
      }
    }
    @media screen and (min-width: 990px) {
      #BannerWithNewsletter-{{ section.id }} .banner__media.ratio {
        --ratio-percent: {{ ratio_percent }}%;
      }
    }
  {% endstyle %}
{%- else -%}
  {% liquid
    assign aspect_ratio = section.settings.image_ratio | split: '/'
    assign temp = aspect_ratio[0] | append: '.0'
    assign ratio_percent = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
  %}
  {% style %}
    #BannerWithNewsletter-{{ section.id }} .banner__media.ratio {
    	--ratio-percent: {{ ratio_percent }}%;
    }
  {% endstyle %}
{%- endif -%}

{% style %}
  @media screen and (min-width: 750px) {
    {% for scheme in settings.color_schemes -%}
      [data-scheme='dark'] .banner.color-{{ scheme.id }},
      .image-banner__icon.color-{{ scheme.id }} {
        --color-background: {{ scheme.settings.colors_background_1.red }},{{ scheme.settings.colors_background_1.green }},{{ scheme.settings.colors_background_1.blue }};
        --color-foreground: {{ scheme.settings.colors_text.red }}, {{ scheme.settings.colors_text.green }}, {{ scheme.settings.colors_text.blue }};
        --color-foreground-secondary: {{ scheme.settings.colors_secondary_text.red }}, {{ scheme.settings.colors_secondary_text.green }}, {{ scheme.settings.colors_secondary_text.blue }};
        --color-accent: {{ scheme.settings.colors_text.red }}, {{ scheme.settings.colors_text.green }}, {{ scheme.settings.colors_text.blue }};
        --color-foreground-title: {{ scheme.settings.colors_text_title.red }}, {{ scheme.settings.colors_text_title.green }}, {{ scheme.settings.colors_text_title.blue }};

        {% if scheme.settings.background_gradient != empty %}
          --gradient-background: {{ scheme.settings.background_gradient }};
        {% else %}
          --gradient-background: {{ scheme.settings.colors_background_1 }};
        {% endif %}
      }
    {% endfor %}
  }

  @media (prefers-color-scheme: dark) {
    {% for scheme in settings.color_schemes -%}
      [data-scheme='auto'] .banner.color-{{ scheme.id }},
      .image-banner__icon.color-{{ scheme.id }} {
        --color-background: {{ scheme.settings.colors_background_1.red }},{{ scheme.settings.colors_background_1.green }},{{ scheme.settings.colors_background_1.blue }};
        --color-foreground: {{ scheme.settings.colors_text.red }}, {{ scheme.settings.colors_text.green }}, {{ scheme.settings.colors_text.blue }};
        --color-foreground-secondary: {{ scheme.settings.colors_secondary_text.red }}, {{ scheme.settings.colors_secondary_text.green }}, {{ scheme.settings.colors_secondary_text.blue }};
        --color-accent: {{ scheme.settings.colors_text.red }}, {{ scheme.settings.colors_text.green }}, {{ scheme.settings.colors_text.blue }};
        --color-foreground-title: {{ scheme.settings.colors_text_title.red }}, {{ scheme.settings.colors_text_title.green }}, {{ scheme.settings.colors_text_title.blue }};

        {% if scheme.settings.background_gradient != empty %}
          --gradient-background: {{ scheme.settings.background_gradient }};
        {% else %}
          --gradient-background: {{ scheme.settings.colors_background_1 }};
        {% endif %}
      }
    {% endfor %}
  }
{% endstyle %}

{% style %}
   {% render 'section-margin' %}
   @media screen and (min-width: 750px) {
  	#BannerWithNewsletter-{{ section.id }} .banner__overlay {
  		background-color: rgba(var(--color-overlay), {{ section.settings.opacity_overlay }});
  	}
  }
{% endstyle %}

<div
  id="BannerWithNewsletter-{{ section.id }}"
  class="banner-newsletter relative {% if section.settings.full_width %}{% else %}container{% endif %}"
>
  {%- if section.settings.image != blank -%}
    {% liquid
      assign width_ratio = 1
      if image_ratio != 'adapt'
        assign aspect_ratio_img = section.settings.image.aspect_ratio | round: 2
        assign aspect_ratio_settings = aspect_ratio[0] | plus: 0.0 | divided_by: aspect_ratio[1] | round: 2

        if aspect_ratio_img > aspect_ratio_settings
          assign width_ratio = aspect_ratio_img | divided_by: aspect_ratio_settings | round: 2
        endif
      endif

      if section.settings.image.width > section.settings.image.height
        assign width_adapt_ratio = 250 | times: section.settings.image.aspect_ratio | round: 2
      endif
    %}

    {% capture sizes %}
        (min-width: 750px) calc((100vw - 40px) * {{ width_ratio }}),
        {% if section.settings.image.width > section.settings.image.height %}
          {{ width_adapt_ratio }}px
        {% else %}
          calc((100vw - 40px) * {{ width_ratio }})
        {% endif %}
			{% endcapture %}
    {%- if section.settings.image_link != blank -%}
      <a
        href="{{ section.settings.image_link }}"
        class="banner__media media ratio{% if section.settings.image_mobile %} banner__media--with-mobile-img{% endif %}"
        aria-label="{{ section.settings.image_link.title }}"
      >
    {%- else -%}
      <div
        class="banner__media media ratio{% if section.settings.image_mobile %} banner__media--with-mobile-img{% endif %}"
      >
    {%- endif -%}
    {%- if section.settings.image -%}
      {{
        section.settings.image
        | image_url: width: section.settings.image.width
        | image_tag:
          class: 'banner__media-img banner__media-img--desktop',
          loading: 'lazy',
          widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3264, 3400, 3584, 3800, 4000, 4200, 4400, 4600, 4800, 5000, 5200, 5400, 5600',
          sizes: sizes
      }}
    {%- endif -%}
    {%- if section.settings.image_mobile -%}
      {{
        section.settings.image_mobile
        | image_url: width: section.settings.image.width
        | image_tag:
          class: 'banner__media-img banner__media-img--mobile',
          loading: 'lazy',
          widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3264, 3400, 3584, 3800, 4000, 4200, 4400, 4600, 4800, 5000, 5200, 5400, 5600',
          sizes: sizes
      }}
    {%- endif -%}
    {%- if section.settings.image_link != blank -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}
    <div class="banner-newsletter absolute top-0 w-full z-10 flex items-center">
      <div class="banner-newsletter__wrapper flex flex-col items-start w-full mx-auto" style="max-width: 1300px;">
        <div class="color-{{ section.settings.color_scheme }}">
          {%- if section.settings.subheading != blank -%}
            <div class="banner-newsletter__subheading {{ section.settings.subheading_style }}">
              {{ section.settings.subheading }}
            </div>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_level }} class="banner-newsletter__heading {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </{{ section.settings.heading_level }}>
          {%- endif -%}
          {%- if section.settings.text_information != blank -%}
            <div class="banner-newsletter__text body-large">{{ section.settings.text_information }}</div>
          {%- endif -%}
        </div>
        <div
          class="banner-newsletter__form"
          style="background: {{ section.settings.newsletter_color_background }};"
        >
          <banner-newsletter>
            {%- if section.settings.newsletter_heading != blank -%}
              <div class="banner-newsletter__form-head">
                <p>{{ section.settings.newsletter_heading }}</p>
              </div>
            {%- endif -%}
            <div class="banner-newsletter__form-main">
              {% form 'customer', class: '' %}
                <div class="flex items-center">
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div>
                    <div class="field">
                      <input
                        id="BannerNewsletterForm--{{ section.id }}"
                        type="email"
                        name="contact[email]"
                        class="field__input field"
                        value="{{ form.email }}"
                        aria-required="true"
                        autocorrect="off"
                        autocapitalize="off"
                        autocomplete="email"
                        pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
                        {% if form.errors %}
                          autofocus
                          aria-invalid="true"
                          aria-describedby="BannerNewsletter-error--{{ section.id }}"
                        {% elsif form.posted_successfully? %}
                          aria-describedby="BannerNewsletter-success--{{ section.id }}"
                        {% endif %}
                        placeholder="{{ 'newsletter.label' | t }}"
                        required
                      >
                      <label class="visually-hidden" for="BannerNewsletterForm--{{ section.id }}">
                        {{ 'newsletter.label' | t }}
                      </label>
                    </div>
                  </div>
                  <button
                    type="submit"
                    class="button button--{{ section.settings.newsletter_button_style }} focus-inset"
                    name="commit"
                  >
                    <span>{{ 'newsletter.button_label' | t }}</span>
                  </button>
                </div>
                {%- if form.posted_successfully? -%}
                  <small
                    class="banner-newsletter-form__message"
                    id="BannerNewsletter-success--{{ section.id }}"
                    tabindex="-1"
                    autofocus
                  >
                    {% render 'icon-success' -%}
                    {{- 'newsletter.success' | t }}
                  </small>
                {%- endif -%}
                {%- if form.errors -%}
                  <small
                    class="banner-newsletter-form__message"
                    id="Newsletter-error--{{ section.id }}"
                  >
                    {%- render 'icon-error' -%}
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </small>
                {%- endif -%}
              {% endform %}
            </div>
            <div class="banner-newsletter__form-foot cursor-pointer">
              <div class="banner-newsletter__form-agreement flex items-start">
                <input type="checkbox" id="BannerNewsletter-agreement--{{ section.id }}">
                <label for="BannerNewsletter-agreement--{{ section.id }}">
                  {{ section.settings.newsletter_agreement }}
                </label>
              </div>
              <small
                class="banner-newsletter-form__message banner-newsletter__form-agreement-message hidden"
                id="Newsletter-agreement-error--{{ section.id }}"
              >
                {%- render 'icon-error' -%}
                {{- section.settings.newsletter_agreement_error }}
              </small>
            </div>
          </banner-newsletter>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.banner-newsletter.name",
  "tag": "section",
  "class": "banner-newsletter-section spaced-section",
  "limit": 1,
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "t:sections.image-banner.settings.full_width.label"
    },
    {
      "type": "range",
      "id": "opacity_overlay",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0,
      "label": "t:sections.image-banner.settings.opacity_overlay.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-banner.settings.header__2.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-banner.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.image-banner.settings.image_mobile.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.image-banner.settings.image_ratio.options__1.label"
        },
        {
          "value": "2/1",
          "label": "t:sections.image-banner.settings.image_ratio.options__2.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.image-banner.settings.image_ratio.options__3.label"
        },
        {
          "value": "4/3",
          "label": "t:sections.image-banner.settings.image_ratio.options__4.label"
        },
        {
          "value": "16/9",
          "label": "t:sections.image-banner.settings.image_ratio.options__5.label"
        },
        {
          "value": "21/9",
          "label": "t:sections.image-banner.settings.image_ratio.options__6.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.image-banner.settings.image_ratio.options__7.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.image-banner.settings.image_ratio.label"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "t:sections.image-banner.settings.image_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-banner.settings.header__3.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-3",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.image-banner.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_level",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_level.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_level.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_level.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_level.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.image-banner.settings.subheading.label"
    },
    {
      "type": "select",
      "id": "subheading_style",
      "options": [
        {
          "value": "subtitle",
          "label": "t:sections.all.subheading_style.options__1.label"
        },
        {
          "value": "subtitle subtitle--secondary",
          "label": "t:sections.all.subheading_style.options__2.label"
        }
      ],
      "default": "subtitle",
      "label": "t:sections.all.subheading_style.label"
    },
    {
      "type": "text",
      "id": "text_information",
      "label": "t:sections.image-banner.settings.text_information.label"
    },
    {
      "type": "select",
      "id": "text_align",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-banner.settings.text_align.options__1.label"
        },
        {
          "value": "top-left",
          "label": "t:sections.image-banner.settings.text_align.options__2.label"
        },
        {
          "value": "bottom-left",
          "label": "t:sections.image-banner.settings.text_align.options__3.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-banner.settings.text_align.options__4.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-banner.settings.text_align.options__5.label"
        },
        {
          "value": "top-right",
          "label": "t:sections.image-banner.settings.text_align.options__6.label"
        },
        {
          "value": "bottom-right",
          "label": "t:sections.image-banner.settings.text_align.options__7.label"
        }
      ],
      "default": "left",
      "label": "t:sections.image-banner.settings.text_align.label"
    },
    {
      "type": "color_background",
      "id": "newsletter_color_background",
      "label": "t:sections.image-banner.settings.newsletter_color_background.label"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:sections.image-banner.settings.newsletter_heading.label"
    },
    {
      "type": "select",
      "id": "newsletter_button_style",
      "options": [
        {
          "group": "t:sections.all.button.button_style.group__1.label",
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "group": "t:sections.all.button.button_style.group__1.label",
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "group": "t:sections.all.button.button_style.group__1.label",
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        },
        {
          "group": "t:sections.all.button.button_style.group__2.label",
          "value": "simple",
          "label": "t:sections.all.button.button_style.options__4.label"
        },
        {
          "group": "t:sections.all.button.button_style.group__2.label",
          "value": "simple_secondary",
          "label": "t:sections.all.button.button_style.options__5.label"
        },
        {
          "group": "t:sections.all.button.button_style.group__2.label",
          "value": "simple_link",
          "label": "t:sections.all.button.button_style.options__6.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.all.button.button_style.label"
    },
    {
      "type": "richtext",
      "id": "newsletter_agreement",
      "label": "t:sections.image-banner.settings.newsletter_agreement.label"
    },
    {
      "type": "textarea",
      "id": "newsletter_agreement_error",
      "label": "t:sections.image-banner.settings.newsletter_agreement_error.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.banner-newsletter.presets.name"
    }
  ]
}
{% endschema %}
