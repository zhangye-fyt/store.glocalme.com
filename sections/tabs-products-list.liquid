      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:sections.tabs-products-list.blocks.tab.name",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "label": "t:sections.tabs-products-list.blocks.tab.settings.title.label",
