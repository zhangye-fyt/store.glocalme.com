      "label": "t:sections.all.image_ratio.label"
    },
    {
      "type": "select",
      "id": "product_image_fit",
      "label": "t:sections.all.image_fit.label",
      "options": [
        {
          "value": "contain",
          "label": "t:sections.all.image_fit.options__1.label"
        },
        {
          "value": "cover",
          "label": "t:sections.all.image_fit.options__2.label"
        }
      ],
