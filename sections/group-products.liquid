{{ 'component-group-products.css' | asset_url | stylesheet_tag }}

<script src="{{ 'group-products.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<div
  id="GroupProducts-{{ section.id }}"
  class="group-products section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} background"
>
  <group-products>
    <div class="container">
      <div class="group-products__cover">
        <div
          class="ratio group-products__cover--desktop"
          style="--ratio-percent: {{ 1 | divided_by: section.settings.cover.aspect_ratio | times: 100 | round: 2 }}%"
        >
          {{
            section.settings.cover
            | image_url: width: section.settings.cover.width
            | image_tag:
              loading: 'lazy',
              widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3264, 3400, 3584, 3800, 4000, 4200, 4400, 4600, 4800, 5000, 5200, 5400, 5600',
              sizes: '100vw'
          }}
        </div>
        {%- if section.settings.cover_mobile -%}
          <div
            class="ratio group-products__cover--mobile"
            style="--ratio-percent: {{ 1 | divided_by: section.settings.cover_mobile.aspect_ratio | times: 100 | round: 2 }}%"
          >
            {{
              section.settings.cover_mobile
              | image_url: width: section.settings.cover_mobile.width
              | image_tag:
                loading: 'lazy',
                widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3264, 3400, 3584, 3800, 4000, 4200, 4400, 4600, 4800, 5000, 5200, 5400, 5600',
                sizes: '100vw'
            }}
          </div>
        {%- endif -%}
      </div>
      <div
        class="group-products__products grid"
        style="grid-template-columns: repeat({{section.settings.product_list.size}}, minmax(0, 1fr));"
      >
        {%- liquid
          assign image_ratio = section.settings.product_image_ratio
          assign aspect_ratio = image_ratio | split: '/'
          assign temp = aspect_ratio[0] | append: '.0'
          assign ratio_percent = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
        -%}
        {%- capture style -%}object-fit: {{ section.settings.product_image_fit }};{%- endcapture -%}
        {% for product in section.settings.product_list %}
          {%- liquid
            if image_ratio == 'adapt' and product.featured_media != blank
              assign ratio_percent = 1 | divided_by: product.featured_media.aspect_ratio | times: 100 | round: 2
            elsif image_ratio == 'adapt' and product.featured_media == blank
              assign ratio_percent = 100
            endif
          -%}
          <div class="group-products__product color-{{ section.settings.product_color_scheme }} background">
            <div class="group-products__product-box flex flex-col h-full">
              <a
                class="ratio group-products__product-image"
                style="--ratio-percent: {{ ratio_percent }}%;"
                href="{{ product.url | default: '#' }}"
              >
                {{
                  product.featured_media
                  | image_url: width: 750
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) calc((100vw - 40px) / 3), calc(100vw - 40px)',
                    widths: '360, 535, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600',
                    width: product.featured_media.width,
                    height: product.featured_media.height,
                    style: style
                }}
              </a>
              <div class="group-products__product-content flex-1">
                <div class="group-products__product-title">{{ product.title }}</div>

                <dropdown-component class="dropdown group-products__product-dropdown">
                  <input
                    class="dropdown__input"
                    type="text"
                    id="group-products-{{ product.id }}-{{ section.id }}"
                    placeholder
                    value="{{ product.selected_or_first_available_variant.title}}"
                    data-param="{{ product.selected_or_first_available_variant.id }}"
                    readonly
                  >
                  <label for="group-products-{{ product.id }}-{{ section.id }}"></label>
                  <ul class="dropdown__list">
                    {%- for variant in product.variants -%}
                      <li
                        class="dropdown__item"
                        data-value="{{ variant.title }}"
                        data-param="{{- variant.id -}}"
                        data-url="{{ product.url }}"
                      >
                        {{- variant.title -}}
                      </li>
                    {%- endfor -%}
                  </ul>
                  {% render 'icon-caret' %}
                </dropdown-component>
                <div class="group-products__product-price">
                  {% render 'price', product: product, use_variant: true %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="group-products__button w-full flex items-center">
        <button class="button button--secondary flex-1" data-type="add-to-cart">
          {{ 'products.product.add_to_cart' | t }}
        </button>
        <button class="button button--primary flex-1" data-type="buy-now">
          {{ 'products.product.buy_now' | t }}
        </button>
      </div>
    </div>
  </group-products>
</div>

{% schema %}
