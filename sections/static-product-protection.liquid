<!-- sections/static-product-protection.liquid -->
 
<section class="section static-shipping-info">
  <div class="responsive-container">
    <h1 class="h2">{{ 'product_protection_faq_title' | t }}</h1>
 
    <style>
      .responsive-container {
        max-width: 1200px;
        margin: 50px auto;
        padding: 20px;
        box-sizing: border-box;
      }
      .static-shipping-info {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        line-height: 1.6;
        color: #333;
      }
      .static-shipping-info h1 {
        font-size: 2em;
        margin-bottom: 1em;
        font-weight: 600;
      }
      .static-shipping-info h2 {
        margin-top: 2em;
        font-size: 1.6em;
        font-weight: 600;
        color: #111;
      }
      .static-shipping-info strong {
        font-weight: 600;
      }
      .static-shipping-info ul,
      .static-shipping-info ol {
        margin-bottom: 1.2em;
        padding-left: 1.8em;
      }
      .static-shipping-info table {
        border-collapse: collapse;
        width: 100%;
        margin: 20px 0;
        font-size: 0.95em;
      }
      .static-shipping-info table,
      .static-shipping-info th,
      .static-shipping-info td {
        border: 1px solid #ddd;
      }
      .static-shipping-info th,
      .static-shipping-info td {
        padding: 10px;
        text-align: center;
      }
      .static-shipping-info .note {
        margin-top: 10px;
        font-weight: 600;
        color: #444;
      }
      .static-shipping-info a {
        color: #0066cc;
        text-decoration: underline;
      }
 
      @media (max-width: 768px) {
        .responsive-container {
          padding: 16px;
        }
        .static-shipping-info table {
          font-size: 0.85em;
          overflow-x: auto;
          display: block;
        }
      }
    </style>
 
    <p><strong>{{ 'q1' | t }}</strong></p>
    <p><strong>{{ 'q1_a1_title' | t }}</strong> {{ 'q1_a1_content' | t }}</p>
    <p><strong>{{ 'q1_a2_title' | t }}</strong> {{ 'q1_a2_content' | t }}</p>
    <p><strong>{{ 'q1_a3_title' | t }}</strong> {{ 'q1_a3_content' | t }}</p>
    <p><strong>{{ 'q1_a4_title' | t }}</strong> {{ 'q1_a4_content' | t }}</p>
 
    <p><strong>{{ 'q2' | t }}</strong></p>
    <p><strong>{{ 'q2_a1_title' | t }}</strong> {{ 'q2_a1_content' | t }}</p>
    <blockquote>
      <p><strong>{{ 'q2_a2_title' | t }}</strong> {{ 'q2_a2_content' | t }}</p>
      <p><strong>{{ 'q2_example' | t }}</strong></p>
    </blockquote>
 
    <table>
      <thead>
        <tr>
          <th>{{ 'year_1' | t }}</th>
          <th>{{ 'year_2' | t }}</th>
          <th>{{ 'year_3' | t }}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>{{ 'accidental_damage' | t }}</td>
          <td>{{ 'accidental_damage' | t }}</td>
          <td>{{ 'accidental_damage' | t }}</td>
        </tr>
        <tr>
          <td>{{ 'manufacturer_warranty' | t }}</td>
          <td>{{ 'extended_warranty' | t }}</td>
          <td>{{ 'extended_warranty' | t }}</td>
        </tr>
      </tbody>
    </table>
 
    <p><strong>{{ 'q3' | t }}</strong></p>
    <p><u>{{ 'q3_within_60' | t }}</u></p>
    <ul>
      <li>{{ 'q3_refund_no_claims' | t }}</li>
      <li>{{ 'q3_refund_with_claims' | t }}</li>
    </ul>
 
    <p><u>{{ 'q3_after_60' | t }}</u></p>
    <ul>
      <li>{{ 'q3_refund_formula' | t }}</li>
    </ul>
 
    <p><strong>{{ 'q4' | t }}</strong></p>
    <ol>
      <li>{{ 'q4_step1_html' | t }}</li>
      <li>{{ 'q4_step2_html' | t: email: 'support@xcottons.com' }}</li>
    </ol>
 
    <p><strong>{{ 'key_note' | t }}</strong> {{ 'liability_limit' | t }}</p>
 
  </div>
</section>

