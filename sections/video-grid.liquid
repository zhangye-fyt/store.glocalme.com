{{ 'popup-modal.css' | asset_url | stylesheet_tag }}
{{ 'section-video-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}

  #VideoGrid-{{ section.id }} .video-grid__list {
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
  }

  @media (min-width: 750px) {
    #VideoGrid-{{ section.id }} .video-grid__list {
      grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

<div id="VideoGrid-{{ section.id }}" class="video-grid section-{{ section.id }}-padding">
  <div class="container">
    <div class="video-grid__list">
      {% for block in section.blocks %}
        <div class="video-grid__item cursor-pointer">
          <modal-opener
            class="block no-js-hidden"
            data-modal="#VideoModal-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <button
              class="block w-full"
              type="button"
              aria-haspopup="dialog"
            >
              <div class="video-grid__media">
                {%- if block.settings.cover_image != blank -%}
                  <div
                    class="video-grid__media-image relative"
                    {% if section.settings.aspect_ratio == 'adapt' and block.settings.cover_image != null %}
                      style="padding-bottom: {{ 1 | divided_by: block.settings.cover_image.aspect_ratio | times: 100 }}%"
                    {% else %}
                      {% if section.settings.aspect_ratio == 'adapt' %}
                        style="aspect-ratio: 16/9;"
                      {% else %}
                        style="aspect-ratio: {{ section.settings.aspect_ratio }};"
                      {% endif %}
                    {% endif %}
                  >
                    <img
                      srcset="
                        {%- if block.settings.cover_image.width >= 375 -%}{{ block.settings.cover_image | image_url: width: '375x' }} 375w,{%- endif -%}
                        {%- if block.settings.cover_image.width >= 750 -%}{{ block.settings.cover_image | image_url: width: '750x' }} 750w,{%- endif -%}
                        {%- if block.settings.cover_image.width >= 1100 -%}{{ block.settings.cover_image | image_url: width: '1100x' }} 1100w,{%- endif -%}
                        {%- if block.settings.cover_image.width >= 1500 -%}{{ block.settings.cover_image | image_url: width: '1500x' }} 1500w,{%- endif -%}
                        {%- if block.settings.cover_image.width >= 1780 -%}{{ block.settings.cover_image | image_url: width: '1780x' }} 1780w,{%- endif -%}
                        {%- if block.settings.cover_image.width >= 2000 -%}{{ block.settings.cover_image | image_url: width: '2000x' }} 2000w,{%- endif -%}
                        {%- if block.settings.cover_image.width >= 3000 -%}{{ block.settings.cover_image | image_url: width: '3000x' }} 3000w,{%- endif -%}
                        {%- if block.settings.cover_image.width >= 3840 -%}{{ block.settings.cover_image | image_url: width: '3840x' }} 3840w,{%- endif -%}
                        {{ block.settings.cover_image | image_url: width: 'master' }} {{ block.settings.cover_image.width }}w
                      "
                      src="{{ block.settings.cover_image | image_url: width: '1920x' }}"
                      sizes="{% if block.settings.full_width %}100vw{% else %}(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw{% endif %}"
                      alt="{{ 'sections.video.load_video' | t: description: block.settings.description | escape }}"
                      loading="lazy"
                      width="{{ block.settings.cover_image.width }}"
                      height="{{ block.settings.cover_image.height }}"
                    >
                  </div>
                  <span class="video-grid__play-button">
                    {% render 'icon-play' %}
                  </span>
                {%- else -%}
                  {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                {%- endif -%}
              </div>
              <div class="video-grid__content">
                {% if block.settings.subheading != blank %}
                  <div class="video-grid__subheading {{ block.settings.subheading_style }}">
                    {% if block.settings.subheading_icon != 'none' %}
                      <i class="icon icon-pack icon-{{ block.settings.subheading_icon }}"></i>
                    {% endif %}
                    {{ block.settings.subheading | truncate: 30, '' | escape }}
                  </div>
                {% endif %}

                {% if block.settings.heading != blank %}
                  <{{ block.settings.heading_level }} class="title video-grid__heading {{ block.settings.heading_size }}">
                    {{ block.settings.heading | truncate: 30, '' | escape }}
                  </{{ block.settings.heading_level }}>
                {% endif %}
              </div>
            </button>
          </modal-opener>
          <modal-dialog
            id="VideoModal-{{ block.id }}"
            class="popup-modal video-popup-modal"
            {{ block.shopify_attributes }}
          >
            <div
              role="dialog"
              aria-label="{{ settings.country_checker_button_text }}"
              aria-modal="true"
              class="popup-modal__content"
              tabindex="-1"
            >
              <button
                id="ModalClose-{{ block.id }}"
                type="button"
                class="popup-modal__close modal-close-button focus-inset"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                {% render 'icon-close' %}
              </button>
              <div
                class="video-popup-modal__iframe"
                {% if section.settings.aspect_ratio == 'adapt' and block.settings.video != null %}
                  style="padding-bottom: {{ 1 | divided_by: block.settings.video.aspect_ratio | times: 100 }}%"
                {% else %}
                  {% if section.settings.aspect_ratio == 'adapt' %}
                    style="aspect-ratio: 16/9;"
                  {% else %}
                    style="aspect-ratio: {{ section.settings.aspect_ratio }};"
                  {% endif %}
                {% endif %}
              >
                {%- if block.settings.video == null and block.settings.video_url != null -%}
                  {%- if block.settings.video_url.type == 'youtube' -%}
                    <iframe
                      src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?enablejsapi=1&autoplay=1{%- if block.settings.video_autoplay -%}&mute=1{%- endif -%}{%- if block.settings.video_autoplay != true and block.settings.video_muted -%}&mute=1{%- endif -%}{%- if block.settings.video_controls != true -%}&controls=0{%- endif -%}{%- if block.settings.video_loop -%}&playlist={{ block.settings.video_url.id }}&loop=1{%- endif -%}"
                      class="js-youtube"
                      allow="encrypted-media"
                      allowfullscreen
                      title="{{ block.settings.description | escape }}"
                    ></iframe>
                  {%- else -%}
                    <iframe
                      src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay=true{%- if block.settings.video_autoplay -%}&muted=true{%- endif -%}{%- if block.settings.video_autoplay != true and block.settings.video_muted -%}&muted=true{%- endif -%}{%- if block.settings.video_controls != true -%}&controls=false{%- endif -%}{%- if block.settings.video_loop -%}&loop=true{%- endif -%}"
                      class="js-vimeo"
                      allow="encrypted-media"
                      allowfullscreen
                      title="{{ block.settings.description | escape }}"
                    ></iframe>
                  {%- endif -%}
                {%- else -%}
                  {{
                    block.settings.video
                    | video_tag: image_size: '1300x', controls: block.settings.true, autoplay: false, loop: false
                  }}
                {% endif %}
              </div>
            </div>
          </modal-dialog>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

