{% liquid
  if section.settings.layout == 'bar'
    if section.settings.position != 'bottom' and section.settings.position != 'top'
      assign width = section.settings.width | append: 'px'
    else
      assign width = '100%'
    endif
  else
    assign width = section.settings.width | append: 'px'
  endif
%}
<style>
  .popup-main{
    overflow-y: auto;
        max-height: calc(100vh - 48 * 2px);
        
  }
  .popup-heading.image_zhong{
    width: 100%;
    
    text-align: center;
    font-size: 22px;
    font-weight: 800;
    line-height: 120%;
    position: absolute;
    top: 40px;
    z-index:3;
    max-width: 100%;
  }
  .desc_button{
    position:unset !important;
    width: 100% !important;
    cursor: pointer;
    padding: 15px 24px;
    border-radius: 40px;
    transform:unset !important;
    color: #fff;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    line-height: 100%;
    transition-property: all;
    transition-timing-function: cubic-bezier(.4,0,.2,1);
    transition-duration: .2s;
    margin-top: 24px;
    
  }
  .just_policy{
    margin: 0;
   
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .just_policy.one_policy{
   
    margin-top: 24px;
   
  }
  .just_policy.the_two_policy{
    margin-top: 10px;
  }
  .number_one_policy[type="checkbox"]{
    -webkit-appearance: none;
      -moz-appearance: none;
      appearance: none;
      background-color: #fff;
      border: 1px solid #333;
      height: 16px;
      width: 16px;
      border-radius: 2px;
      position: relative;
  }
  .number_one_policy[type="checkbox"]:checked {
      background-color: #333;
      
    }
    .number_one_policy[type="checkbox"]:checked::after {
      content: "";
      position: absolute;
      width: 5px;
      height: 10px;
      border: solid #fff;
        border-top-width: medium;
        border-right-width: medium;
        border-bottom-width: medium;
        border-left-width: medium;
      border-width: 0 2px 2px 0;
      top: 50%;
      left: 50%;
      transform: translate(-50%,-50%) rotate(45deg);
    }
    .number_one_policy_text{
      color: #6d6d6f;
      font-size: 14px;
      font-weight: 600;
      line-height: 120%;
      flex: 1 1;
    }
    .number_one_policy_text a {
      color: inherit;
      text-decoration: underline;
    }
  .popup-main .newsletter-form__inner{
    display:block
  }
  .popup-main .popup-content .modal-close-button.jsut_close_buttom{
    cursor: pointer;
    z-index: 2;
    background: transparent;
    border: none;
    padding: 0;
    top: 16px;
    right: 16px;
    width: auto;
    height: unset;
  }
  .jsut_letter_popup{
    background-color: #fff !important;
    border: 1px solid #333 !important;
  }
  .popup-main .popup-content{
    padding: 40px 20px;
  }
  .popup-main .newsletter-form .field__input{
    padding-right:1.2rem
  }
  .popup-main-image--top .popup-thumbnail{
    padding-bottom: 100%;
  }



  @media (min-width: 768px) {
  .popup-heading.image_zhong {
    font-size: 30px;
  }
  .popup-main .popup-content .modal-close-button.jsut_close_buttom{
    top: 26px;
    right: 26px;
  }

  .popup-main .popup-content{
    padding: 40px 48px;
  }
}
</style>
{% if section.settings.is_position == 'position_left' %}
  {% style %}

.theoneopo {
    position: fixed;
    z-index: 9000;
    filter: drop-shadow(rgba(249, 249, 249, 0.15) 0px 0px 30px);
    top: {{section.settings.is_pensent}}%;
    left: 0;
    transform-origin: left top;
    margin-left: 0px;
    width: 84px;
    opacity: 0;
    transform: translateX(-100%) rotate(-90deg);
    animation: slideInproduct 0.5s ease-in-out 2s forwards;
}
.needsclick.kl-teaser-SA25iC p {
    margin: 0;
}

@keyframes slideInproduct {
    from {
        transform: translateX(-100%) rotate(-90deg);
        opacity: 0;
    }
    to {
        transform: translateX(0) rotate(-90deg);
        opacity: 1;
    }
}

@keyframes slideOutproduct {
    from {
        transform: translateX(0) rotate(-90deg);
        opacity: 1;

    }
    to {
        transform: translateX(-100%) rotate(-90deg);
        opacity: 0;
    }
}
.theoneopo.move {
    animation: slideOutproduct 0.5s ease-in-out forwards;
    z-index: 0; /* 退出时降低层级 */
}
.theoneopo.hidden {
opacity: 0;
  left: -35%;
}
.thisoneclose{
  bottom: -16px; 
  right: -16px; 
  position: absolute; 
  z-index: 6; 
  cursor: pointer; 
  height: 20px; 
  width: 20px; 
  border-radius: 50%;
}
  {% endstyle %}

  {% else %}


  {% style %}

.position_right {
    position: fixed;
    z-index: 9000;
    filter: drop-shadow(rgba(249, 249, 249, 0.15) 0px 0px 30px);
    top: {{section.settings.is_pensent}}%;
    right: 0;              /* ✅ 改成 right 固定在右边 */
    transform-origin: right top; /* ✅ 动画基准点改右上角 */
    margin-right: 0;
    width: 84px;
    opacity: 0;
    transform: translateX(100%) rotate(90deg); /* ✅ 初始从右边滑入 */
    animation: slideInproductRight 0.5s ease-in-out 2s forwards;
}
@keyframes slideInproductRight {
  from {
    transform: translateX(100%) rotate(90deg);
    opacity: 0;
  }
  to {
    transform: translateX(0) rotate(90deg);
    opacity: 1;
  }
}
@keyframes slideOutproductRight {
  from {
    transform: translateX(0) rotate(90deg);
    opacity: 1;
  }
  to {
    transform: translateX(100%) rotate(90deg);
    opacity: 0;
  }
}
.position_right.move {
  animation: slideOutproductRight 0.5s ease-in-out forwards;
  z-index: 0;
}

.position_right.hidden {
  opacity: 0;
  right: -35%;
}
.thisoneclose{
  bottom: -16px; 
  left: -16px; 
  position: absolute; 
  z-index: 6; 
  cursor: pointer; 
  height: 20px; 
  width: 20px; 
  border-radius: 50%;
}

  {% endstyle %}

{% endif %}

