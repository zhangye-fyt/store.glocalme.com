<div
  class="
    popup-main popup popup-main_letter
    popup--{{ section.settings.position }}
    popup-main-image--{{ section.settings.image_layout }}
    {% if section.settings.image == blank %} popup-main--no-image {% endif %}
  "
  {% if section.settings['popup-id'] != blank %}
    id="{{ section.settings.popup-id }}"
  {% endif %}
  data-limit-display="{{ section.settings.limit-display }}"
  data-limit-lifetime="{{ section.settings.limit-cache }}"
  data-open-trigger="{{ section.settings.trigger-open }}"
  data-open-delay-number="{{ section.settings.trigger-open-delay }}"
  data-open-scroll-position="{{ section.settings.open-scroll-position }}"
  data-open-scroll-type="{{ section.settings.open-scroll-type }}"
  {% if section.settings['manual-selector'] != blank %}
    data-open-manual-selector="{{ section.settings.manual-selector }}"
  {% endif %}
  
  data-open-is-clicktheone="{% if section.settings.is-clicked %}is-click{% else %}none{% endif %}"
  
  data-close-trigger="{{ section.settings.trigger-close }}"
  data-close-delay-number="{{ section.settings.trigger-close-delay }}"
  data-close-scroll-position="{{ section.settings.close-scroll-position }}"
  data-close-scroll-type="{{ section.settings.close-scroll-type }}"
  data-open-animation="popupOpen{{ section.settings.open-animation }}"
  data-exit-animation="popupExit{{ section.settings.exit-animation }}"
  data-overlay="{{ section.settings.show-overlay }}"
  data-mobile-disable="{{ section.settings.mobile }}"
  data-body-scroll-disable="{{ section.settings.scrolling }}"
  data-overlay-close="{{ section.settings.overlay-close }}"
  data-esc-close="{{ section.settings.esc-close }}"
  data-f4-close="{{ section.settings.f4-close }}"
  data-id="{{ section.id }}"
  style="width: {{ width }}"
>
  <div class="popup-wrap color-{{ section.settings.color_scheme }} background">
    <div class="popup-container">
      <div
        class="popup-outer {%- if section.settings.image != blank %} popup-outer_image {% endif %}"
        {% if section.settings.background != blank %}
          style="--background: {{ section.settings.background }};"
        {% endif %}
      >
        {% if section.settings.image != blank %}
          <div class="popup-thumbnail">
            {% capture style %}
            object-fit: {{ section.settings.image_fit }};
          {% endcapture %}
            {{
              section.settings.image
              | image_url: width: section.settings.image.width
              | image_tag: loading: 'lazy', widths: '275, 550, 750, 990, 1200, 1360, 1600, 1800', style: style
            }}
            
          </div>
           {%- for block in section.blocks -%}
            
              {%- case block.type -%}
                {%- when 'popup_heading' -%}
                  {% if block.settings.heading != blank %}
                    <h2 class="popup-heading image_zhong" {{ block.shopify_attributes }} style="color: {{ block.settings.heading_color }};">
                      {{ block.settings.heading }}
                    </h2>
                  {% endif %}
                {% endcase %}
              {% endfor %}
        {% endif %}
        <div
          class="popup-content popup-content--{{ section.settings.content_align }} {% if section.settings.background != blank %} popup-content_bg {% endif %}"
          style="--opacity: {{ section.settings.overlay_opacity }};"
          x-data="{
        accepted: false,
        check() {
          // 检查页面上任意 .number_one_policy 是否被选中
          this.accepted = Array.from($el.querySelectorAll('.number_one_policy'))
                               .some(cb => cb.checked);
        },
        submitIfAccepted(e) {
          // 如果 accepted 为 false，阻止提交并显示提示
          if (!this.accepted) {
            e.preventDefault();
            // 触发提示（可见性用 x-show 控制）
            this.$refs.policyMsg.classList.add('shake'); // 可选：添加动画
            this.$refs.policyMsg.focus();
          }
          // 否则允许表单正常提交（不需要额外处理）
        }
      }"
      x-init="check()"
      @change="check()"
      @submit="submitIfAccepted($event)"
        >
          {%- assign content_before_divider = '' -%}
          {%- assign content_after_divider = '' -%}

          {%- for block in section.blocks -%}
            {%- capture block_content -%}
              {%- case block.type -%}
                {%- when 'popup_heading' -%}
                  {% if block.settings.heading != blank %}
                    <h2 class="popup-heading" {{ block.shopify_attributes }} style="display:none">
                      {{ block.settings.heading }}
                    </h2>
                  {% endif %}
                {%- when 'popup_description' -%}
                  {% if block.settings.description != blank %}
                    <p class="popup-description" {{ block.shopify_attributes }}>
                      {{ block.settings.description }}
                    </p>
                  {% endif %}
                {%- when 'button' -%}
                  {% render 'button',
                    link: block.settings.button_link,
                    label: block.settings.button_label,
                    style: block.settings.button_style,
                    class: 'popup'
                  %}
                {%- when 'subscribe_form' -%}
                  {% form 'customer', class: 'newsletter-form_popu' %}
                    <div class="newsletter-form__inner {% if section.settings.width <= 500 %} newsletter-form__inner_column {% endif %} color-{{ block.settings.color_scheme }}" {{ block.shopify_attributes }}>
                      <input type="hidden" name="contact[tags]" value="newsletter">
                      <div class="newsletter-form__field-wrapper">
                        <div class="field">
                          <input
                            id="NewsletterForm--{{ section.id }}"
                            type="email"
                            name="contact[email]"
                            class="field__input field jsut_letter_popup"
                            value="{{ form.email }}"
                            aria-required="true"
                            autocorrect="off"
                            autocapitalize="off"
                            autocomplete="email"
														pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
                            {% if form.errors %}
                              autofocus
                              aria-invalid="true"
                              aria-describedby="Newsletter-error--{{ section.id }}"
                            {% elsif form.posted_successfully? %}
                              aria-describedby="Newsletter-success--{{ section.id }}"
                            {% endif %}
                            placeholder="{{ block.settings.placeholder_input }}"
                            required
                          >
                          <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">
                            {{ 'newsletter.label' | t }}
                          </label>
                        </div>
                                <p class="one_policy just_policy">
                                  <input class="number_one_policy" name="policy[policy]" type="checkbox" checked="">
                                  <span class="number_one_policy_text">
                                    By signing up, you agree to Anker's 
                                    <a href="/policies/terms-of-service" target="_blank" rel="noopener noreferrer">Terms of Use</a> 
                                    and 
                                    <a href="/policies/privacy-policy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.
                                  </span>
                                </p>
                                <p class="the_two_policy just_policy">
                                  <input class="number_one_policy" name="policy[policy]" type="checkbox" checked="">
                                  <span class="number_one_policy_text">
                                    By signing up, you agree to Anker's 
                                    <a href="/policies/terms-of-service" target="_blank" rel="noopener noreferrer">Terms of Use</a> 
                                    and 
                                    <a href="/policies/privacy-policy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.
                                  </span>
                                </p>
                                <p x-ref="policyMsg"
                                  x-show="!accepted"
                                  tabindex="-1"
                                  style="display:none"
                                  x-transition
                                  class="policy-error"
                                >
                                  请先勾选同意条款，才能提交哦 ~
                                </p>
                        {%- if form.errors -%}
                          <small
                            class="newsletter-form__message form__message"
                            id="Newsletter-error--{{ section.id }}"
                          >
                            {%- render 'icon-error' -%}
                            {{- form.errors.translated_fields.email | capitalize }}
                            {{ form.errors.messages.email -}}
                          </small>
                        {%- endif -%}
                      </div>
                      <button
                        type="submit"
                        class="button button--{{ block.settings.button_style }} focus-inset desc_button"
                        name="commit"
                       id="submitBtn"
                      >
                        {{ block.settings.button_label }}
                      </button>
                    </div>
                    {%- if form.posted_successfully? -%}
                      <h3
                        class="newsletter-form__message newsletter-form__message--success form__message"
                        id="Newsletter-success--{{ section.id }}"
                        tabindex="-1"
                        autofocus
                      >
                        {% render 'icon-success' -%}
                        {{- 'newsletter.success' | t }}
                      </h3>
                    {%- endif -%}
                  {% endform %}
                  {% if block.settings.description != blank %}
                    <div class = "popup-text" {{ block.shopify_attributes }}>
                      {{ block.settings.description }}
                    </div>
                  {% endif %}


                  <script>
                    document.addEventListener('DOMContentLoaded', function () {
                      const form = document.getElementById('contact_form');
                      const checkboxes = form.querySelectorAll('.number_one_policy');
                      const submitBtn = document.getElementById('submitBtn');
                      const msg = document.getElementById('policyMsg');

                      function checkAccepted() {
                        const accepted = Array.from(checkboxes).some(cb => cb.checked);
                        submitBtn.disabled = !accepted;
                        if (accepted) {
                          msg.style.display = 'none';
                        }
                        return accepted;
                      }

                      // 初始化按钮状态
                      checkAccepted();

                      // 每次勾选变化时更新状态
                      checkboxes.forEach(cb => {
                        cb.addEventListener('change', checkAccepted);
                      });

                      // 提交前检查
                      form.addEventListener('submit', function (e) {
                        if (!checkAccepted()) {
                          e.preventDefault();
                          msg.style.display = 'block';
                          msg.classList.add('shake');
                          setTimeout(() => msg.classList.remove('shake'), 400);
                        }
                      });
                    });
                    </script>



