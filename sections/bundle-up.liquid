      "id": "marker_heading_color_scheme",
      "default": "background-3",
      "label": "t:sections.bundle-up.settings.marker_heading_color_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.bundle-up.settings.header_3.content"
    },
    {
      "type": "color_scheme",
      "id": "checkbox_color_scheme",
