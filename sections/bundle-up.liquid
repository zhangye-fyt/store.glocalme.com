    {
      "type": "header",
      "content": "t:sections.bundle-up.settings.header_1.content"
    },
    {
      "type": "range",
      "id": "cover_width",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "t:sections.bundle-up.settings.wdith.label",
      "default": 30
    },
    {
