{% # theme-check-disable %}
<link
  rel="stylesheet"
  href="{{ 'component-deferred-media.css' | asset_url }}"
  media="all"
>
<link
  rel="preload"
  href="{{ 'quick-add.css' | asset_url }}"
  as="style"
  onload="this.onload=null;this.rel='stylesheet'"
>
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}

<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{% # theme-check-enable %}

{{ 'component-bundle-up.css' | asset_url | stylesheet_tag }}
{{ 'component-marker.css' | asset_url | stylesheet_tag }}

<script src="{{ 'bundle-up.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cover_ratio = section.settings.cover_ratio
  if cover_ratio == 'adapt' and section.settings.cover != blank
    assign cover_ratio_percent = 1 | divided_by: section.settings.cover.aspect_ratio | times: 100 | round: 2
  else
    assign cover_ratio_percent = 100
  else
    assign cover_aspect_ratio = cover_ratio | split: '/'
    assign cover_temp = cover_aspect_ratio[0] | append: '.0'
    assign cover_ratio_percent = cover_aspect_ratio[1] | divided_by: cover_temp | times: 100 | round: 2
  endif
-%}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}

  @media screen and (min-width: 990px) {
    #BundleUp-{{ section.id }} .bundle-up__media {
      width: {{ section.settings.cover_width }}%;
    }
  }

  #BundleUp-{{ section.id }} .bundle-up__media.ratio {
    --ratio-percent: {{ cover_ratio_percent }}%;
  }

  #BundleUp-{{ section.id }} .bundle-up__left-text,
  #BundleUp-{{ section.id }} .bundle-up__left-text h3 {
    color: {{ section.settings.text_color }};
  }
{%- endstyle -%}

<div
  id="BundleUp-{{ section.id }}"
  class="bundle-up section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} background"
>
  <bundle-up>
    <div class="container">
      <div class="bundle-up__wrapper">
        <div class="bundle-up__media ratio">
          {%- if section.settings.cover -%}
            {{
              section.settings.cover
              | image_url: width: section.settings.cover.width
              | image_tag:
                class: 'block w-full h-full object-cover',
                width: section.settings.cover.width,
                height: section.settings.cover.height,
                loading: 'lazy',
                widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3264, 3400, 3584, 3800, 4000, 4200, 4400, 4600, 4800, 5000, 5200, 5400, 5600',
                sizes: 'calc(100vw - 40px)'
            }}
          {%- else -%}
            {{ 'blog-apparel-3' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          <div class="bundle-up__media-text color-{{ section.settings.title_color_scheme }}">
            <h3>{{ section.settings.title }}</h3>
            <p>{{ section.settings.sub_title }}</p>
          </div>

          {%- assign marker_blocks = section.blocks | where: 'type', 'marker' -%}
          {%- for marker_block in marker_blocks -%}
            {%- style -%}
              {%- liquid
                assign position_y = marker_block.settings.position_y
                if position_y > 100
                  assign position_y = 100
                endif
                assign position_x = marker_block.settings.position_x
                if position_x > 100
                  assign position_x = 100
                endif
              -%}
              #BundleUp-{{ section.id }} .bundle-up__marker-{{ marker_block.id }} .marker-number {
                {% if marker_block.settings.direction_y == 'ttb' %}
                  top: {{ position_y }}%;{% else %}bottom:{{ position_y }}%;
                {% endif %}
                {% if marker_block.settings.direction_x == 'ltr' %}
                  left: {{ position_x }}%;{% else %}right:{{ position_x }}%;
                {% endif %}
              }
              #BundleUp-{{ section.id }} .bundle-up__marker-{{ marker_block.id }} .marker-content {
                {% if marker_block.settings.direction_y == 'ttb' %}
                  top: calc({{ position_y }}%);
                  padding-top: 3.8rem;
                {% else %}
                  bottom: calc({{ position_y }}%);
                  padding-bottom: 3.8rem;
                {% endif %}
              }
            {%- endstyle -%}
            <div class="marker bundle-up__marker-{{ marker_block.id }} color-{{ section.settings.marker_color_scheme }}">
              <div class="marker-number"></div>
              <div class="marker-content">
                <div class="marker-content__inner color-{{ section.settings.marker_heading_color_scheme }}">
                  {% render 'product-card-horizontal',
                    product_card_product: marker_block.settings.product,
                    media_ratio: section.settings.image_ratio,
                    media_fit: section.settings.image_fit,
                    show_secondary_image: false,
                    show_vendor: false,
                    section_id: section.id
                  %}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
        <div class="bundle-up__content relative flex-1 flex flex-col">
          <div class="bundle-up__products flex-1">
            {%- liquid
              assign image_ratio = section.settings.image_ratio
              assign aspect_ratio = image_ratio | split: '/'
              assign temp = aspect_ratio[0] | append: '.0'
              assign ratio_percent = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2

              assign product_blocks = section.blocks | where: 'type', 'product'
            -%}
            {%- for product_block in product_blocks -%}
              {% assign product_item = product_block.settings.product %}
              <div class="bundle-up__product relative active">
                <div class="bundle-up__product-checkbox">
                  <input
                    id="bundle-up-{{ product_block.id }}-{{ product.id }}"
                    type="checkbox"
                    checked
                    data-variant-id="{{ product_item.selected_or_first_available_variant.id }}"
                  >
                  <label
                    class="relative flex items-center justify-center w-full h-full cursor-pointer color-{{ section.settings.checkbox_color_scheme }}"
                    for="bundle-up-{{ product_block.id }}-{{ product.id }}"
                  >
                    <i class="icon-check-1"></i>
                  </label>
                </div>
                {%- assign product_form_id = 'quick-add-' | append: section.id | append: product_item.id -%}

                <modal-opener data-modal="#QuickAdd-{{ product_item.id }}">
                  <button
                    id="{{ product_form_id }}-submit"
                    class="w-full h-full"
                    type="submit"
                    name="add"
                    aria-haspopup="dialog"
                    aria-labelledby="{{ product_form_id }}-submit title-{{ section.id }}-{{ product_item.id }}"
                    data-product-url="{{ product_item.url }}"
                  >
                    <div class="bundle-up__product-wrapper flex h-full">
                      {%- liquid
                        if image_ratio == 'adapt' and product_item.featured_media != blank
                          assign ratio_percent = 1 | divided_by: product_item.featured_media.aspect_ratio | times: 100 | round: 2
                        elsif image_ratio == 'adapt' and product_item.featured_media == blank
                          assign ratio_percent = 100
                        endif
                      -%}
                      {%- capture style -%}object-fit: {{ section.settings.image_fit }};{%- endcapture -%}
                      <div
                        class="bundle-up__product-image ratio"
                        style="--ratio-percent: {{ ratio_percent }}%;"
                      >
                        {%- if product_item.featured_media -%}
                          {{
                            product_item.featured_media
                            | image_url: width: 750
                            | image_tag:
                              loading: 'lazy',
                              sizes: '(min-width: 990px) calc((100vw - 40px) / 3), calc(100vw - 40px)',
                              widths: '360, 535, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600',
                              width: product_item.featured_media.width,
                              height: product_item.featured_media.height,
                              style: style
                          }}
                        {%- else -%}
                          {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </div>
                      <div class="bundle-up__product-content flex-1 flex flex-col justify-between">
                        <div class="relative">
                          <div class="bundle-up__product-title">{{ product_item.title }}</div>
                          <div class="bundle-up__product-description">{{ product_block.settings.description }}</div>
                        </div>
                        <div class="bundle-up__product-price">
                          {% render 'price', product: product_item %}
                        </div>
                      </div>
                    </div>
                  </button>
                </modal-opener>
                <quick-add-modal
                  id="QuickAdd-{{ product_item.id }}"
                  class="quick-add-modal"
                >
                  <div
                    role="dialog"
                    aria-label="{{ 'products.product.choose_product_options' | t: product_name: product_item.title | escape }}"
                    aria-modal="true"
                    class="quick-add-modal__content global-settings-popup"
                  >
                    <button
                      id="ModalClose-{{ product_item.id }}"
                      type="button"
                      class="quick-add-modal__toggle modal-close-button"
                      aria-label="{{ 'accessibility.close' | t }}"
                      tabindex="-1"
                    >
                      {% render 'icon-close' %}
                    </button>
                    <div class="quick-add-modal__content-wrapper">
                      <div
                        id="QuickAddInfo-{{ product_item.id }}"
                        class="quick-add-modal__content-info"
                      ></div>
                    </div>
                  </div>
                </quick-add-modal>
              </div>
            {%- endfor -%}
          </div>
          <div class="bundle-up__buttons flex">
            <button class="button button--secondary flex-1" data-type="add-to-cart">
              {{ 'products.product.add_to_cart' | t }}
            </button>
            <button class="button button--primary flex-1" data-type="buy-now">
              {{ 'products.product.buy_now' | t }}
            </button>
          </div>
        </div>
      </div>
    </div>
  </bundle-up>
</div>

{% schema %}
{
  "name": "t:sections.bundle-up.name",
  "class": "section-bundle-up spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-2",
      "label": "t:sections.footer.settings.color_scheme.label"
