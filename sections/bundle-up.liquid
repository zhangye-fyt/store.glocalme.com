          "label": "t:sections.all.image_ratio.options__6.label"
        },
        {
          "value": "4/5",
          "label": "t:sections.all.image_ratio.options__8.label"
        },
        {
          "value": "9/16",
          "label": "t:sections.all.image_ratio.options__10.label"
        },
        {
          "value": "9/21",
          "label": "t:sections.all.image_ratio.options__12.label"
        },
        {
