<div class="jewelry-hero-{{ section.id }}" id="{{ section.settings.position_2 }}">
  <div class="hero-wrapper-{{ section.id }}">
    <picture>
      <source media="(max-width: 768px)" srcset="{{ section.settings.background_image_mobile | img_url: 'master' }}">
      <img src="{{ section.settings.background_image_desktop | img_url: 'master' }}" alt="Hero Image" class="hero-img-{{ section.id }}">
    </picture>
    <div class="text-content-{{ section.id }}">
      <h3 class="collection-subtitle-{{ section.id }}">{{ section.settings.subtitle }}</h3>
      <div class="collection-description-{{ section.id }}">{{ section.settings.description }}</div>
    </div>
  </div>
</div>

<style>
  .jewelry-hero-{{ section.id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hero-wrapper-{{ section.id }} {
    {% if section.settings.container_width == 'fullscreen' %}
      max-width: 100%;
    {% else %}
      max-width: 1400px;
    {% endif %}
    margin: 0 auto;
    position: relative;
  }

  .hero-img-{{ section.id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .text-content-{{ section.id }} {
    width: {{ section.settings.text_width_desktop }}%;
    text-align: {{ section.settings.text_align }};
    color: {{ section.settings.text_color }};
    position: absolute;
    {% if section.settings.text_bg_color != 'transparent' %}
      background-color: {{ section.settings.text_bg_color }};
      padding: 20px;
      border-radius: 5px;
    {% endif %}
  }

  .collection-subtitle-{{ section.id }} {
    font-size: {{ section.settings.subtitle_font_size_desktop | divided_by: 16.0 }}rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.1;
    font-family: Poppins, Arial, sans-serif;
    margin-bottom: 1.25rem;
  }

  .collection-description-{{ section.id }} p {
    font-size: {{ section.settings.description_font_size_desktop }}px;
    font-weight: 500;
    line-height: 1.3;
    font-family: Poppins, Arial, sans-serif;
    margin-bottom: 2rem;
  }

  @media screen and (min-width: 768px) {
    .jewelry-hero-{{ section.id }} {
      background-color: {{ section.settings.background_color }};
    }

    .text-content-{{ section.id }} {
      {% if section.settings.text_position_desktop == 'top-left' %}
        top: {{ section.settings.text_margin_top_desktop }}%;
        left: {{ section.settings.text_margin_left_desktop }}%;
      {% elsif section.settings.text_position_desktop == 'top-center' %}
        top: {{ section.settings.text_margin_top_desktop }}%;
        left: 50%;
        transform: translateX(-50%);
      {% elsif section.settings.text_position_desktop == 'top-right' %}
        top: {{ section.settings.text_margin_top_desktop }}%;
        right: {{ section.settings.text_margin_right_desktop }}%;
      {% elsif section.settings.text_position_desktop == 'bottom-left' %}
        bottom: {{ section.settings.text_margin_bottom_desktop }}%;
        left: {{ section.settings.text_margin_left_desktop }}%;
      {% elsif section.settings.text_position_desktop == 'bottom-right' %}
        bottom: {{ section.settings.text_margin_bottom_desktop }}%;
        right: {{ section.settings.text_margin_right_desktop }}%;
      {% elsif section.settings.text_position_desktop == 'center' %}
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      {% endif %}
    }
  }

  @media screen and (max-width: 768px) {
    .hero-wrapper-{{ section.id }} {
      height: auto;
    }

    .text-content-{{ section.id }} {
      width: {{ section.settings.text_width_mobile }}%;
      {% if section.settings.text_position_mobile == 'top-left' %}
        top: {{ section.settings.text_margin_top_mobile }}%;
        left: {{ section.settings.text_margin_left_mobile }}%;
      {% elsif section.settings.text_position_mobile == 'top-right' %}
        top: {{ section.settings.text_margin_top_mobile }}%;
        right: {{ section.settings.text_margin_right_mobile }}%;
      {% elsif section.settings.text_position_mobile == 'bottom-left' %}
        bottom: {{ section.settings.text_margin_bottom_mobile }}%;
        left: {{ section.settings.text_margin_left_mobile }}%;
      {% elsif section.settings.text_position_mobile == 'bottom-right' %}
        bottom: {{ section.settings.text_margin_bottom_mobile }}%;
        right: {{ section.settings.text_margin_right_mobile }}%;
      {% elsif section.settings.text_position_mobile == 'center' %}
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      {% endif %}
    }

    .collection-subtitle-{{ section.id }} {
      font-size: {{ section.settings.subtitle_font_size_mobile | divided_by: 16.0 }}rem;
    }

    .collection-description-{{ section.id }} p {
      font-size: {{ section.settings.description_font_size_mobile }}px;
    }
  }
</style>

