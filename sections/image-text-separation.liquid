{{ 'component-image-text-separation.css' | asset_url | stylesheet_tag }}

<script src="{{ 'controllable-slider.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}

  .placeholder-svg {
    width: 100%;
  }
  {%- if section.settings.display_devices == 'desktop' -%}
    #ImageTextSeparation-{{ section.id }} {
      display: none;
    }
    @media screen and (min-width: 750px) {
      #ImageTextSeparation-{{ section.id }} {
        display: block;
      }
    }
  {%- elsif section.settings.display_devices == 'mobile' -%}
    @media screen and (min-width: 750px) {
      #ImageTextSeparation-{{ section.id }} {
        display: none;
      }
    }
  {%- endif -%}
{%- endstyle -%}

<div id="ImageTextSeparation-{{ section.id }}" class="image-text-separation section-{{ section.id }}-padding">
  <div class="container">
    <div class="image-text-separation__wrapper relative overflow-hidden">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'image' -%}
            <div class="image-text-separation__image">
              {%- if block.settings.image != blank -%}
                {%- if block.settings.image_link != blank -%}
                  <a href="{{ block.settings.image_link }}">
                {%- endif -%}
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    class: 'block w-full h-auto',
                    loading: 'lazy',
                    widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3264, 3400, 3584, 3800, 4000, 4200, 4400, 4600, 4800, 5000, 5200, 5400, 5600',
                    sizes: 'calc(100vw - 40px)'
                }}
                {%- if block.settings.image_link != blank -%}
                  </a>
                {%- endif -%}
              {%- else -%}
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          {%- when 'text' -%}
            {%- liquid
              assign position_y = block.settings.position_y
              if position_y > 100
                assign position_y = 100
              endif
              assign position_x = block.settings.position_x
              if position_x > 100
                assign position_x = 100
              endif
              assign max_text_container_max_width = block.settings.max_text_container_max_width
            -%}
            {%- style -%}
              #ImageTextSeparation-{{ section.id }} .image-text-separation__text-{{ block.id }} {
                {% if block.settings.direction_y == 'ttb' %}
                  top: {{ position_y }}%;{% else %}bottom:{{ position_y }}%;
                {% endif %}
                {% if block.settings.direction_x == 'ltr' %}
                  left: {{ position_x }}%;{% else %}right:{{ position_x }}%;
                {% endif %}
                font-size: {{ block.settings.text_font_size }}px;
                font-weight: {{ block.settings.text_font_weight }};
                line-height: {{ block.settings.text_line_height }};
                color: {{ block.settings.text_color }};
                text-align: {{ block.settings.text_align }};
                {% if block.settings.text_gradient_background != blank %}
                  background:{{ block.settings.text_gradient_background }};
                  -webkit-background-clip:text;
                  -webkit-text-fill-color:transparent;
                {% endif %}
                {% if block.settings.text_letter_spacing != blank %}
                  letter-spacing: {{ block.settings.text_letter_spacing }}px;
                {% endif %}
                {% if max_text_container_max_width != blank %}
                  {%- liquid
                    if max_text_container_max_width > 100
                      assign max_text_container_max_width = 100
                    endif
                  -%}
                  max-width: {{ max_text_container_max_width }}%;
                {% else %}
                  {%- liquid
                    assign double_position_x = position_x | times: 2
                    assign max_width = 100 | minus: double_position_x
                  -%}
                  max-width: {{ max_width }}%;
                {% endif %}
              }
              {% if block.settings.enable_text_underline == true %}
                #ImageTextSeparation-{{ section.id }} .image-text-separation__text-{{ block.id }}::after {
                  content: '';
                  position: absolute;
                  left: 0;
                  bottom: -24px;
                  width: {{ block.settings.text_underline_width }}%;
                  height: {{ block.settings.text_underline_height }}px;
                  background:{{ block.settings.text_underline_gradient_background }};
                  clip-path: polygon(0% 0%, 84% 0%, 0% 100%);
                }
                @media screen and (max-width: 749px) {
                  #ImageTextSeparation-{{ section.id }} .image-text-separation__text-{{ block.id }}::after {
                    height: calc({{ block.settings.text_underline_height }}px * 0.5);
                    bottom: -12px
                  }
                }
              {% endif %}
              {%- if section.settings.display_devices == 'desktop' -%}
                @media screen and (max-width: 1759px) {
                  #ImageTextSeparation-{{ section.id }} .image-text-separation__text-{{ block.id }} {
                    font-size: calc(({{ block.settings.text_font_size }} / 1759) * 100vw);
                  }
                  #ImageTextSeparation-{{ section.id }} .image-text-separation__text-{{ block.id }}::after {
                    bottom: calc((-24 / 1759) * 100vw);
                  }
                }
              {%- elsif section.settings.display_devices == 'mobile' -%}
                @media screen and (max-width: 749px) {
                  #ImageTextSeparation-{{ section.id }} .image-text-separation__text-{{ block.id }} {
                    font-size: calc(({{ block.settings.text_font_size }} / 749) * 100vw);
                  }
                  #ImageTextSeparation-{{ section.id }} .image-text-separation__text-{{ block.id }}::after {
                    bottom: calc((-12 / 749) * 100vw);
                  }
                }
              {%- endif -%}
            {%- endstyle -%}
            <div class="image-text-separation__text image-text-separation__text-{{ block.id }} scroll-trigger animate--slide-in">
              {{ block.settings.text }}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

